{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scripta",
  "identifier": "com.scripta.desktop",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Scripta",
        "width": 960,
        "height": 760,
        "minWidth": 640,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "licenseFile": "../../LICENSE",
    "longDescription": "Transcription locale de vidéos YouTube. L'inférence tourne sur votre machine ; rien de ce qui est transcrit ne quitte votre poste.",
    "shortDescription": "Transcription locale de vidéos YouTube.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
