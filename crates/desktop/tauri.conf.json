{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scripta",
  "version": "0.1.0",
  "identifier": "com.scripta.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Scripta",
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "licenseFile": "../../LICENSE",
    "longDescription": "Transcription locale de vidéos YouTube. L'inférence tourne sur votre machine ; rien de ce qui est transcrit ne quitte votre poste.",
    "shortDescription": "Transcription locale de vidéos YouTube."
  }
}
