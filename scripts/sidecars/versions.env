# Versions épinglées des sidecars embarqués dans l'application de bureau —
# SPEC §5.4, tâches 4.1 et 4.2 de la roadmap.
#
# Monter une version, c'est changer ce fichier et rien d'autre : les scripts
# exigent ces empreintes, et refusent tout fichier qui ne les porte pas.

# yt-dlp — exécutables autonomes publiés par le projet. Empreintes relevées
# dans le fichier SHA2-256SUMS de la release.
YTDLP_VERSION=2026.08.19
YTDLP_SHA256_WINDOWS=66674953fe251b89f4d08c5f0e35e0728679bd67ab3d7d05c0562af101dd3e7a
YTDLP_SHA256_LINUX=58162f9bfdc27458ea47bfcb311cf47028f17d8154a8bf7d689861d46399230a
YTDLP_SHA256_MACOS=0f192b7ec147ab6288885d6351d9ab67367640029b4377576ef46dd79cf7b202
# Licence de yt-dlp (Unlicense), et notices des composants que ses
# exécutables embarquent : Python et ses bibliothèques.
YTDLP_LICENSE_SHA256=7e12e5df4bae12cb21581ba157ced20e1986a0508dd10d0e8a4ab9a4cf94e85c
YTDLP_THIRD_PARTY_SHA256=472aefe951c7db35e1657c1d13fd337140511ed6f2b329205105ad441c5a02b7

# FFmpeg — compilé depuis les sources, en configuration minimale
# (build-ffmpeg.sh). Archive vérifiée par sa signature — clé
# FCF9 86EA 15E6 E293 A564 4F10 B432 2F04 D676 58D8, « FFmpeg release signing
# key » — avant d'en relever l'empreinte.
FFMPEG_VERSION=9.0.2
